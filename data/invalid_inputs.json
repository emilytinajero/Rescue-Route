          {
            "donation_id": "D001",
            "donor_name": "Campus Cafe",
            "food_type": "Prepared Meals",
            "quantity": 20,
            "pickup_area": "Fullerton",
            "ready_time": "12:00",
            "expiry_time": "17:00"
          }
        ],
        "recipients": [
          {
            "recipient_id": "R001",
            "organization_name": "Community Shelter",
            "accepted_food_types": [
              "Prepared Meals"
            ],
            "capacity": 50,
            "area": "Fullerton",
            "closing_time": "19:00"
          }
        ]
      }
    },
